# EasyEvent Backend Configuration

PORT=8000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=easyevent-secure-session-secret-key-bengaluru-2026
SESSION_COOKIE_SECURE=false

# Deployment URLs
FRONTEND_URL=https://your-app.vercel.app

# Database Option A: Render PostgreSQL (if using Render Database)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Database Option B: Supabase PostgreSQL (obtain at https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# n8n Automation Webhook (Database Work & User Identification)
# Set to your n8n webhook URL to receive real-time database work & user identity events
N8N_WEBHOOK_URL=http://localhost:5678/webhook/easyevent
