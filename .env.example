# ==============================================================================
# EasyEvent Environment Configuration Example
# Copy this file to .env (or backend/.env) and fill in your Supabase credentials
# ==============================================================================

PORT=8000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=easyevent-secure-session-secret-key-bengaluru-2026
SESSION_COOKIE_SECURE=false

# Supabase Credentials (obtain at https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Frontend Vite API Connection
VITE_API_URL=http://127.0.0.1:8000
